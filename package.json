{
  "name": "manager-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node bin/www",
    "dev": "./node_modules/.bin/nodemon bin/www",
    "prd": "pm2 start bin/www",
    "local": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "local:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-local.ps1",
    "check": "node scripts/check.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "debug": "^4.1.1",
    "jsonwebtoken": "^8.5.1",
    "koa": "^2.7.0",
    "koa-bodyparser": "^4.2.1",
    "koa-convert": "^1.2.0",
    "koa-json": "^2.0.2",
    "koa-logger": "^3.2.0",
    "koa-onerror": "^4.1.0",
    "koa-router": "^7.4.0",
    "koa-static": "^5.0.0",
    "koa-views": "^6.2.0",
    "mongoose": "^5.13.5",
    "pug": "^2.0.3"
  },
  "devDependencies": {
    "log4js": "^6.3.0",
    "nodemon": "^1.19.1"
  },
  "engines": {
    "node": ">=18"
  }
}
